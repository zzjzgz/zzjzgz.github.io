{
  "_source": "由 _workflow/extract_tokens.py 从 index.html 的 :root 自动抽取，请勿手工编辑",
  "color": {
    "--bg": "#f5f5f7",
    "--surface": "#ffffff",
    "--hover": "#fbfbfd",
    "--text": "#1d1d1f",
    "--text-body": "#424245",
    "--text-2": "#6e6e73",
    "--text-3": "#6e6e73",
    "--text-4": "#86868b",
    "--faint": "#d2d2d7",
    "--hairline": "rgba(0,0,0,0.07)",
    "--track": "#e8e8ed",
    "--accent": "#0071e3",
    "--accent-link": "#0066cc",
    "--indigo": "#5e5ce6",
    "--live": "#30d158",
    "--heat": "#ff6b00",
    "--heat-bg": "rgba(255,107,0,0.1)",
    "--on-accent": "#ffffff",
    "--grad-cta": "linear-gradient(135deg,#0071e3 0%,#5e5ce6 100%)"
  },
  "typography": {
    "--font": "-apple-system,BlinkMacSystemFont,'SF Pro Text','SF Pro Display','Helvetica Neue','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "--mono": "ui-monospace,'SF Mono',Menlo,Consolas,monospace"
  },
  "spacing": {
    "--max-read": "720px",
    "--max-grid": "1080px",
    "--pad-x": "22px",
    "--gap-section": "clamp(48px,7vw,88px)"
  },
  "radius": {
    "--r-pill": "999px",
    "--r-chip": "6px",
    "--r-thumb": "12px",
    "--r-card": "18px",
    "--r-panel": "22px",
    "--r-hero": "26px",
    "--r-sheet": "16px"
  },
  "shadow": {
    "--sh-card": "0 1px 2px rgba(0,0,0,0.04),0 8px 24px rgba(0,0,0,0.05)",
    "--sh-panel": "0 1px 3px rgba(0,0,0,0.05),0 14px 40px rgba(0,0,0,0.05)",
    "--sh-lift": "0 12px 32px rgba(0,0,0,0.1)",
    "--sh-cta": "0 20px 54px rgba(0,113,227,0.24)",
    "--sh-overlay": "0 2px 8px rgba(0,0,0,0.10),0 30px 80px rgba(0,0,0,0.24)"
  },
  "motion": {
    "--dur-1": "120ms",
    "--dur-2": "180ms",
    "--dur-3": "280ms",
    "--dur-4": "420ms",
    "--ease-out": "cubic-bezier(0.23,1,0.32,1)",
    "--ease-in-out": "cubic-bezier(0.77,0,0.175,1)",
    "--ease-spring": "cubic-bezier(0.32,0.72,0,1)",
    "--ease-out-quart": "cubic-bezier(0.25,1,0.5,1)",
    "--ease-soft": "ease"
  }
}
